{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// The server runs as native Node.js ESM (tsx in development), so relative imports carry
		// their runtime `.js` extension. Editors and `tsc` resolve modules the same way Node does.
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"]
	},
	"include": ["src", "tsdown.config.ts"]
}
