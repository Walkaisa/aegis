# Aegis – configuration template. Copy to `.env` and fill in the secrets.

# Public URL under which Aegis is reachable (origin only, no trailing slash).
# Behind a reverse proxy in production, e.g. https://auth.example.com
AEGIS_ISSUER=http://localhost:3000

# 32 random bytes (base64). Generate with: openssl rand -base64 32
# Keep it safe: changing it after the setup makes all stored secrets unreadable.
AEGIS_ENCRYPTION_KEY=

# PostgreSQL credentials, used by docker compose.
# Generate a password with: openssl rand -hex 24
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=

# Connection URL for running the server outside of Docker (pnpm dev).
# docker compose builds its own URL from the POSTGRES_* values above.
AEGIS_DATABASE_URL=postgres://aegis:CHANGE_ME@127.0.0.1:5432/aegis

# Host address and port docker compose publishes Aegis on.
AEGIS_BIND_ADDRESS=127.0.0.1
AEGIS_PORT=3000

# Set to true (or the number of proxy hops) when Aegis runs behind a reverse proxy.
AEGIS_TRUST_PROXY=false

AEGIS_LOG_LEVEL=info

# Argon2id password hashing (RFC 9106, second recommended option).
AEGIS_ARGON2_MEMORY_KIB=65536
AEGIS_ARGON2_ITERATIONS=3
AEGIS_ARGON2_PARALLELISM=4

# How long activity entries are kept.
AEGIS_AUDIT_RETENTION_DAYS=180
